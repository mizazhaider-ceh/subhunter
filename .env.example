# SubHunter v5.0 - Environment Configuration
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# API Keys (Optional - enhances passive recon)
# ──────────────────────────────────────────────

# SecurityTrails API (future integration)
# SECURITYTRAILS_API_KEY=your_key_here

# Shodan API (future integration)  
# SHODAN_API_KEY=your_key_here

# VirusTotal API (future integration)
# VIRUSTOTAL_API_KEY=your_key_here

# ──────────────────────────────────────────────
# Scan Configuration
# ──────────────────────────────────────────────

# Default concurrency level (1-500)
# SUBHUNTER_CONCURRENCY=100

# Default DNS resolver
# SUBHUNTER_DNS_RESOLVER=8.8.8.8

# Report output directory
# SUBHUNTER_REPORT_DIR=reports
